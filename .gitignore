# ==============================================================================
# .gitignore - Ứng dụng Web Nhận diện Cảm xúc Khuôn mặt (Facial Emotion Recognition)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Môi trường ảo Python & Cache
# ------------------------------------------------------------------------------
# Virtual Environment
.venv/
.venv-*/
venv/
env/
ENV/
env.bak/
venv.bak/

# Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Build & Phân phối gói Python
build/
dist/
*.egg-info/
*.egg

# ------------------------------------------------------------------------------
# 2. Môi trường Frontend / Node.js
# ------------------------------------------------------------------------------
# Thư viện phụ thuộc
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Bản build ứng dụng (Vite / React)
dist/
dist-ssr/
build/
out/

# Cache công cụ frontend
.eslintcache
.stylelintcache
.vite/
.turbo/

# ------------------------------------------------------------------------------
# 3. Dataset & Model Checkpoints (Dữ liệu nặng > 100MB)
# ------------------------------------------------------------------------------
# Checkpoints & Trọng số mô hình Deep Learning
*.pth
*.pt
*.onnx
*.h5
*.tflite
*.pkl
*.bin
*.joblib

# [LƯU Ý]: Bỏ comment dòng bên dưới nếu muốn theo dõi file model demo fer2013_model.pth (kích thước ~5MB)
!fer2013_model.pth

# Tập dữ liệu thô & file huấn luyện (FER-2013)
*.csv
fer2013.csv
data/
dataset/
datasets/
raw_data/
train/
test/
val/

# ------------------------------------------------------------------------------
# 4. Docker, Database Cục bộ & Dữ liệu lưu trữ
# ------------------------------------------------------------------------------
# Volumes lưu trữ dữ liệu MongoDB
mongo_data/
data/db/

# File sao lưu & xuất dữ liệu
*.dump
*.tar
*.tar.gz
*.gz

# SQLite & Prisma Database (Local development)
*.db
*.db-journal
*.sqlite
*.sqlite3
dev.db
prisma/dev.db

# ------------------------------------------------------------------------------
# 5. Biến môi trường & Bảo mật (Tuyệt đối không commit lên Git)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ------------------------------------------------------------------------------
# 6. Cấu hình Editor & File rác Hệ điều hành
# ------------------------------------------------------------------------------
# IDE / Editor (VS Code, JetBrains)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
